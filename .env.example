PORT=5000
MONGO_URI=your_mongodb_atlas_uri
CLIENT_URL=http://localhost:5173

# Admin credentials & Auth
# - Generate the secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# - Generate the password hash: node scripts/hash-password.js "your password here"
# - The bcrypt hash contains $ characters. Wrap it in single quotes in .env.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h
